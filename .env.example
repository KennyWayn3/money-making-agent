# ──────────────────────────────────────────
# Nevermined Configuration
# ──────────────────────────────────────────
# Get your API key at https://nevermined.app/settings/api-keys
# Use 'sandbox:' prefix for testing, 'live:' for production
NVM_API_KEY=sandbox:your-api-key-here
NVM_ENVIRONMENT=sandbox

# After running `npm run register`, fill in:
NVM_AGENT_ID=did:nv:your-agent-id
NVM_PLAN_ID=did:nv:your-plan-id
NVM_BUILDER_ADDRESS=0xYourWalletAddress

# ──────────────────────────────────────────
# AI Provider (OpenAI or compatible)
# ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ──────────────────────────────────────────
# Server
# ──────────────────────────────────────────
PORT=3000
